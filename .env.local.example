# Optional: Supabase is only needed for account-based project pages.
# Find these in Supabase Dashboard > Connect > App Frameworks > Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: use your own DeepSeek key on the local development server.
# The server key is never used by the public production endpoint.
# Others can enter their own key in /demo > 模型设置.
# AI_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-flash
# AI_API_KEY=your-deepseek-key
